---
/**
 * Jetline has no logo asset — the incumbent site set the name in Playfair and
 * called it a mark. So this is the mark: a progress strip with its final cell
 * live. Three fields, the last one amber, which is exactly what the business
 * does — a movement handed along until it closes.
 */
interface Props {
  /** Renders the descriptor line beneath the wordmark. Footer and hero only. */
  full?: boolean;
  class?: string;
}

const { full = false, class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <svg class="wordmark__mark" viewBox="0 0 30 16" aria-hidden="true" focusable="false">
    <rect x="0.6" y="0.6" width="28.8" height="14.8" fill="none" stroke="currentColor" stroke-width="1.2"
    ></rect>
    <path d="M10.6 0.6V15.4M20.2 0.6V15.4" stroke="currentColor" stroke-width="1.2"></path>
    <rect x="20.2" y="0.6" width="9.2" height="14.8" fill="var(--signal)"></rect>
  </svg>
  <span class="wordmark__type">
    <span class="wordmark__name">Jetline</span>
    {full && <span class="wordmark__descriptor">Executive Ground Transportation</span>}
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--bone);
  }

  .wordmark__mark {
    width: 1.75rem;
    height: auto;
    flex: none;
    overflow: visible;
  }

  .wordmark__type {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    font-stretch: 84%;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .wordmark__descriptor {
    font-family: var(--font-rail);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-faint);
    line-height: 1;
  }
</style>
